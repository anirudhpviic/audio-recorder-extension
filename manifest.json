{
  "manifest_version": 3,
  "name": "Audio Recorder Extension",
  "description": "Audio recorder extension that record and generate MOM of the meeting.",
  "version": "1.0",
  "action": {
    "default_popup": "./index.html"
  },

  "permissions": [
    "tabCapture",
    "offscreen",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "downloads.shelf",
    "notifications"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/content/mic-content.js",
        "src/content/mute-check-content.js",
        "src/content/meet-content.js",
        "src/content/meet-start-check-content.js",
        "src/content/meet-end-check-content.js"
      ]
    }
  ]
}
